{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/job-registry.v1.json",
  "title": "Job Dispatcher Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "jobs"],
  "properties": {
    "schema": { "const": "design-pipeline.job-registry.v1" },
    "version": { "const": "1" },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "activation", "priority", "keywords", "primaryKnowledge", "secondaries", "kernel"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "activation": { "enum": ["explicit", "scored", "default"] },
          "priority": { "type": "integer", "minimum": 0 },
          "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "primaryKnowledge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "action", "admission"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "admission": { "enum": ["ready", "review", "reference-only", "inert"] }
            }
          },
          "secondaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "command", "action", "admission"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 },
                "action": { "type": "string", "minLength": 1 },
                "admission": { "enum": ["ready", "review", "reference-only", "inert"] }
              }
            }
          },
          "kernel": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["foundation", "toolchain"] }
          }
        }
      }
    }
  }
}
