{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/component-capability-registry.v1.json",
  "title": "Component Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "reviewedAt", "capabilities"],
  "properties": {
    "schema": { "const": "design-pipeline.component-capability-registry.v1" },
    "version": { "const": "1" },
    "reviewedAt": { "type": "string", "format": "date" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "keywords", "requires", "verification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "verification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
