{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/toolchain-receipt.v1.json",
  "title": "Frontend Tool Invocation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "planSha256", "status", "tool", "invocation", "startedAt", "completedAt", "artifacts", "evidenceReceipts", "notes"],
  "properties": {
    "schema": { "const": "design-pipeline.toolchain-receipt.v1" },
    "id": { "type": "string", "minLength": 1 },
    "planSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["complete", "partial", "blocked"] },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "exitCode"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exitCode": { "type": "integer" }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "evidenceReceipts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
