{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/motion-verification.v1.json",
  "title": "Motion Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "primitiveId",
    "trigger",
    "purpose",
    "durationMs",
    "toleranceMs",
    "observedDurationMs",
    "frameCadenceMs",
    "interruption",
    "reducedMotion",
    "longFrames",
    "maxLongFrameMs",
    "captureId",
    "deterministic"
  ],
  "properties": {
    "schema": {
      "const": "design-pipeline.motion-verification.v1"
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "primitiveId": {
      "type": "string",
      "pattern": "\\S"
    },
    "trigger": {
      "type": "string",
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "pattern": "\\S"
    },
    "interruption": {
      "type": "string",
      "pattern": "\\S"
    },
    "reducedMotion": {
      "type": "string",
      "pattern": "\\S"
    },
    "captureId": {
      "type": "string",
      "pattern": "\\S"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "toleranceMs": {
      "type": "number",
      "minimum": 0
    },
    "observedDurationMs": {
      "type": "number",
      "minimum": 0
    },
    "frameCadenceMs": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxLongFrameMs": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "longFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atMs",
          "durationMs"
        ],
        "properties": {
          "atMs": {
            "type": "number",
            "minimum": 0
          },
          "durationMs": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "deterministic": {
      "const": true
    },
    "lifecycle": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "status",
              "expected",
              "observed",
              "captureId"
            ],
            "properties": {
              "scenario": {
                "enum": [
                  "rapid-input",
                  "reverse",
                  "unmount",
                  "reduced-motion",
                  "resize",
                  "route-change"
                ]
              },
              "status": {
                "const": "passed"
              },
              "expected": {
                "type": "string",
                "pattern": "\\S"
              },
              "observed": {
                "type": "string",
                "pattern": "\\S"
              },
              "captureId": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario",
              "status",
              "reason"
            ],
            "properties": {
              "scenario": {
                "const": "reverse"
              },
              "status": {
                "const": "not-applicable"
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "scenario": {
                "const": "rapid-input"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "scenario": {
                "const": "reverse"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "scenario": {
                "const": "unmount"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "scenario": {
                "const": "reduced-motion"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "scenario": {
                "const": "resize"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "scenario": {
                "const": "route-change"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  }
}
