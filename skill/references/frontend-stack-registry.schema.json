{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/frontend-stack-registry.v1.json",
  "title": "Frontend Stack And Tool Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "reviewedAt", "styling", "uiLibraries", "shadcn", "tools"],
  "properties": {
    "schema": { "const": "design-pipeline.frontend-stack-registry.v1" },
    "version": { "const": "1" },
    "reviewedAt": { "type": "string", "format": "date" },
    "styling": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/option" } },
    "uiLibraries": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/option" } },
    "shadcn": { "type": "object" },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } }
  },
  "$defs": {
    "option": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } }
  }
}
