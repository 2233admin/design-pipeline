{
  "schema": "design-pipeline.film-storyboard.v1",
  "id": "canvas-launch-12s",
  "durationSec": 12,
  "fps": 30,
  "grammar": "continuous-transformation",
  "benefit": "Ideas on the canvas turn into a finished storyboard without leaving the canvas.",
  "proofAction": "A typed prompt connects to a generated image, and the image drops into a storyboard strip.",
  "reference": "reference.md#primary (continuous object handoffs, 0:04-0:11)",
  "sound": {
    "mode": "scored",
    "source": "user-licensed track 'Lift' (auditioned, see sound.md)",
    "usage": "commercial",
    "assets": [
      { "id": "lift", "license": "user-owned commercial license", "commercialUse": true, "file": "assets/score.wav" }
    ],
    "cues": [
      { "id": "music-in", "atSec": 0, "kind": "entry", "note": "soft pad under the typing" },
      { "id": "connect-tick", "atSec": 2.4, "kind": "accent", "note": "click as the edge snaps" },
      { "id": "drop-1", "atSec": 5, "kind": "downbeat", "note": "beat drop as the image blooms" },
      { "id": "strip-hit", "atSec": 8.2, "kind": "impact", "note": "hit as frame lands in strip" },
      { "id": "music-out", "atSec": 12, "kind": "exit", "note": "ring out under logo" }
    ]
  },
  "beats": [
    {
      "id": "type-prompt",
      "startSec": 0,
      "endSec": 2.4,
      "role": "action",
      "subject": "prompt node",
      "productAction": "User types a prompt into a canvas node",
      "transformation": { "kind": "state-change", "from": "empty node", "to": "node with prompt text" },
      "handoff": "open",
      "motion": ["kinetic-type", "cursor-travel"],
      "choreography": "kinetic-type",
      "soundCues": ["music-in"]
    },
    {
      "id": "connect-edge",
      "startSec": 2.4,
      "endSec": 5,
      "role": "action",
      "subject": "edge from prompt to image node",
      "productAction": "User drags an edge from the prompt to a new image node",
      "transformation": { "kind": "state-change", "from": "isolated prompt", "to": "connected graph" },
      "handoff": "continuation",
      "motion": ["cursor-travel", "edge-draw"],
      "choreography": "ui-demo",
      "soundCues": ["connect-tick"]
    },
    {
      "id": "image-bloom",
      "startSec": 5,
      "endSec": 8.2,
      "role": "action",
      "subject": "image node",
      "productAction": "The image node renders the generated picture",
      "transformation": { "kind": "morph", "from": "placeholder tile", "to": "finished image" },
      "handoff": "camera-carry",
      "motion": ["camera-push", "clip-reveal"],
      "choreography": "camera-push",
      "soundCues": ["drop-1"]
    },
    {
      "id": "into-storyboard",
      "startSec": 8.2,
      "endSec": 10.6,
      "role": "action",
      "subject": "generated image",
      "productAction": "The image drops into the storyboard strip as frame 3",
      "transformation": { "kind": "morph", "from": "canvas node", "to": "storyboard frame" },
      "handoff": "morph",
      "motion": ["continuous-morph"],
      "choreography": "continuous-morph",
      "soundCues": ["strip-hit"]
    },
    {
      "id": "brand",
      "startSec": 10.6,
      "endSec": 12,
      "role": "brand-hold",
      "subject": "logo over the finished strip",
      "productAction": "Logo resolves over the finished storyboard",
      "transformation": { "kind": "none" },
      "handoff": "continuation",
      "motion": ["fade-in"],
      "soundCues": ["music-out"]
    }
  ]
}
