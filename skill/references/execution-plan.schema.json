{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/execution-plan.v1.json",
  "title": "Execution Target Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "id", "toolchainPlanSha256", "mode", "projectRoot", "executionRoot", "branch", "baseBranch", "baseHead", "dirtyAtResolution", "slices", "cleanup", "blockers"],
  "properties": {
    "schema": { "const": "design-pipeline.execution-plan.v1" },
    "status": { "enum": ["ready", "blocked"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "toolchainPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["in-place", "worktree", "sequential"] },
    "projectRoot": { "type": "string", "minLength": 1 },
    "executionRoot": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "baseHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "dirtyAtResolution": { "type": "boolean" },
    "slices": { "$ref": "execution-request.schema.json#/properties/slices" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onComplete", "onFailure"],
      "properties": {
        "onComplete": { "enum": ["remove-if-clean", "not-applicable"] },
        "onFailure": { "const": "retain" }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
