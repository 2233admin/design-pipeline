{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/execution-receipt.v1.json",
  "title": "Execution Target Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "status", "executionPlanSha256", "toolchainPlanSha256", "mode", "target", "invocation", "changedFiles", "outOfScope", "startedAt", "completedAt", "evidenceReceipts", "notes", "blockers", "cleanup"],
  "properties": {
    "schema": { "const": "design-pipeline.execution-receipt.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "status": { "enum": ["complete", "failed", "blocked"] },
    "executionPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "toolchainPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mode": { "enum": ["in-place", "worktree", "sequential"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "executionRoot", "branch", "baseHead", "finalHead"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "executionRoot": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "baseHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "finalHead": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
      }
    },
    "invocation": { "$ref": "execution-outcome.schema.json#/properties/invocation" },
    "changedFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "outOfScope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "evidenceReceipts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": { "enum": ["removed", "retained", "not-applicable"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
