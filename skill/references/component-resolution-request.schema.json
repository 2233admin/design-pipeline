{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/component-resolution-request.v1.json",
  "title": "Component Capability Resolution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "framework"],
  "anyOf": [{ "required": ["brief"] }, { "required": ["capabilities"] }],
  "properties": {
    "schema": { "const": "design-pipeline.component-resolution-request.v1" },
    "framework": { "enum": ["agnostic", "react", "vue", "nuxt", "svelte", "solid"] },
    "brief": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "preferredProviders": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
