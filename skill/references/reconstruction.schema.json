{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-pipeline.local/reconstruction.schema.json",
  "title": "Design Pipeline Static Reference Reconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "referenceId",
    "mode",
    "coordinateSpaces",
    "rectification",
    "camera",
    "landmarks",
    "geometryGate",
    "finalComparison"
  ],
  "properties": {
    "schema": { "const": "design-pipeline.reconstruction.v1" },
    "id": { "type": "string", "minLength": 1 },
    "referenceId": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["exact-reconstruction", "adaptive-reconstruction"]
    },
    "coordinateSpaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "canonical", "world", "camera"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "canonical": { "type": "string", "minLength": 1 },
        "world": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 }
      }
    },
    "rectification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "artifact",
        "frontElevation",
        "sourceViewport",
        "canonicalViewport",
        "anchors"
      ],
      "properties": {
        "method": {
          "enum": [
            "planar-homography",
            "multi-plane",
            "not-required-front-view"
          ]
        },
        "artifact": { "type": "string", "minLength": 1 },
        "frontElevation": { "type": "string", "minLength": 1 },
        "sourceViewport": { "$ref": "#/$defs/viewport" },
        "canonicalViewport": { "$ref": "#/$defs/viewport" },
        "anchors": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "canonical"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "$ref": "#/$defs/point" },
              "canonical": { "$ref": "#/$defs/point" }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "locked",
        "calibrationArtifact",
        "renderViewport",
        "parameters"
      ],
      "properties": {
        "model": { "enum": ["perspective", "orthographic"] },
        "locked": { "const": true },
        "calibrationArtifact": { "type": "string", "minLength": 1 },
        "renderViewport": { "$ref": "#/$defs/viewport" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "near",
            "far",
            "position",
            "target",
            "up",
            "rollDegrees"
          ],
          "properties": {
            "near": { "type": "number", "exclusiveMinimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 },
            "position": { "$ref": "#/$defs/vector3" },
            "target": { "$ref": "#/$defs/vector3" },
            "up": { "$ref": "#/$defs/vector3" },
            "rollDegrees": { "type": "number" },
            "verticalFovDegrees": {
              "type": "number",
              "minimum": 1,
              "maximum": 179
            },
            "viewHeight": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "landmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayArtifact", "thresholds", "points"],
      "properties": {
        "overlayArtifact": { "type": "string", "minLength": 1 },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minCount",
            "minRegions",
            "maxMeanErrorPx",
            "maxPointErrorPx"
          ],
          "properties": {
            "minCount": { "type": "integer", "minimum": 1 },
            "minRegions": { "type": "integer", "minimum": 1 },
            "maxMeanErrorPx": { "type": "number", "minimum": 0 },
            "maxPointErrorPx": { "type": "number", "minimum": 0 }
          }
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "region", "source", "render"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "region": {
                "enum": [
                  "top-left",
                  "top-right",
                  "center",
                  "bottom-left",
                  "bottom-right"
                ]
              },
              "source": { "$ref": "#/$defs/point" },
              "render": { "$ref": "#/$defs/point" }
            }
          }
        }
      }
    },
    "graybox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "capturedAt",
        "viewport",
        "suppressed",
        "comparison",
        "approval"
      ],
      "properties": {
        "capture": { "type": "string", "minLength": 1 },
        "capturedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "viewport": { "$ref": "#/$defs/viewport" },
        "runtimeMode": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mechanism", "token", "disables"],
              "properties": {
                "mechanism": {
                  "enum": [
                    "root-attribute",
                    "query-parameter",
                    "build-flag",
                    "runtime-api"
                  ]
                },
                "token": { "type": "string", "minLength": 1 },
                "disables": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        },
        "suppressed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["materials", "glow", "bloom", "depth-of-field", "scanlines", "grading"]
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "regions"],
          "properties": {
            "mode": { "enum": ["measured", "qualitative"] },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "finding", "status"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "finding": { "type": "string", "minLength": 1 },
                  "status": {
                    "enum": [
                      "matches",
                      "corrected",
                      "accepted-deviation",
                      "open"
                    ]
                  }
                }
              }
            }
          }
        },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "geometryGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval"],
      "properties": {
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "finalComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "referenceRender",
        "implementationRender",
        "diffArtifact",
        "intentionalMasks",
        "thresholds",
        "metrics",
        "evidencePort",
        "approval"
      ],
      "properties": {
        "status": { "enum": ["pending", "measured"] },
        "referenceRender": { "type": "string", "minLength": 1 },
        "implementationRender": { "type": "string", "minLength": 1 },
        "diffArtifact": { "type": "string", "minLength": 1 },
        "intentionalMasks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxPixelDifferenceRatio", "minSsim"],
          "properties": {
            "maxPixelDifferenceRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minSsim": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "metrics": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["pixelDifferenceRatio", "ssim"],
          "properties": {
            "pixelDifferenceRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ssim": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "evidencePort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "adapter",
            "availableCapabilities",
            "lastProbe",
            "receiptArtifact"
          ],
          "properties": {
            "status": { "enum": ["pending", "ready"] },
            "adapter": { "type": "string", "minLength": 1 },
            "availableCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "lastProbe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ok", "evidence"],
              "properties": {
                "ok": { "type": "boolean" },
                "evidence": { "type": "string", "minLength": 1 }
              }
            },
            "receiptArtifact": { "type": "string", "minLength": 1 }
          }
        },
        "approval": { "$ref": "#/$defs/approval" }
      }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
