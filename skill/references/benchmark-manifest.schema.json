{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/benchmark-manifest.v1.json",
  "title": "Designer Pipeline Benchmark Manifest",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "requiredDimensions", "scenarios"],
      "properties": {
        "schema": { "const": "design-pipeline.benchmark-manifest.v1" },
        "id": { "type": "string", "minLength": 1 },
        "requiredDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "scenarios": { "type": "array", "minItems": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "candidateSystem", "systems", "systemChannels", "fairness", "requiredDimensions", "scenarios"],
      "properties": {
        "schema": { "const": "design-pipeline.benchmark-manifest.v2" },
        "id": { "type": "string", "minLength": 1 },
        "candidateSystem": { "type": "string", "minLength": 1 },
        "systems": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "systemChannels": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "enum": ["stable", "canary", "beta", "experimental"] }
        },
        "allowCanaryMix": { "type": "boolean", "default": false },
        "fairness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["samePrompts", "sameEnvironmentClass", "evaluatorBlind", "expectedAnswersHidden", "freshContext", "representativeDelivery"],
          "properties": {
            "samePrompts": { "const": true },
            "sameEnvironmentClass": { "const": true },
            "evaluatorBlind": { "const": true },
            "expectedAnswersHidden": { "const": true },
            "freshContext": { "const": true },
            "representativeDelivery": { "const": true }
          }
        },
        "requiredDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "operation", "dimension", "required", "threshold", "evidenceType", "prompt"],
            "anyOf": [
              { "required": ["privateExpectations"] },
              { "required": ["expectedComponents"] }
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "operation": { "enum": ["generate", "edit", "repair"] },
              "dimension": { "enum": ["responsive", "accessibility", "palette", "motion", "scene", "component-state", "evidence"] },
              "required": { "type": "boolean" },
              "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidenceType": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string", "minLength": 1 },
              "privateExpectations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "expectedComponents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  ]
}
