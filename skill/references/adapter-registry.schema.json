{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/adapter-registry.v1.json",
  "title": "Designer Pipeline adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "adapters"],
  "properties": {
    "schema": { "const": "design-pipeline.adapter-registry.v1" },
    "version": { "type": "string", "minLength": 1 },
    "adapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "support", "kind", "hostPolicy", "versionRange", "provenance", "license", "security", "evidenceTypes", "degradation", "benchmarkAdmission"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "support": { "enum": ["native", "generic-workflow", "companion", "reference-only", "unsupported", "out-of-scope"] },
        "kind": { "type": "string", "minLength": 1 },
        "hostPolicy": { "type": "string", "minLength": 1 },
        "versionRange": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "required": ["kind", "url"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "reviewedVersion": { "type": "string", "minLength": 1 }
          }
        },
        "license": {
          "type": "object",
          "required": ["state", "id"],
          "properties": {
            "state": { "enum": ["verified", "unverified", "platform", "project", "service"] },
            "id": { "type": ["string", "null"] }
          }
        },
        "security": {
          "type": "object",
          "required": ["execution", "network", "credentials"],
          "properties": {
            "execution": { "type": "string", "minLength": 1 },
            "network": { "type": "string", "minLength": 1 },
            "credentials": { "type": "boolean" }
          }
        },
        "evidenceTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "degradation": { "type": "string", "minLength": 1 },
        "benchmarkAdmission": { "enum": ["required", "optional", "blocked"] },
        "install": { "type": "string", "minLength": 1 },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "plan", "invoke", "verify"],
      "properties": {
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command", "timeoutMs"],
          "properties": {
            "kind": { "const": "command" },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guide", "dependencies", "requirements"],
          "properties": {
            "guide": { "type": "string", "minLength": 1 },
            "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "invoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "entrypoint", "command"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 },
            "entrypoint": { "type": "string", "minLength": 1 },
            "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receiptSchema", "evidenceTypes"],
          "properties": {
            "receiptSchema": { "type": "string", "minLength": 1 },
            "evidenceTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
