{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/design-system-decision.v1.json",
  "title": "Design System Runtime Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "mode", "projectAuthority", "selected", "rejected", "rationale", "evidence", "frontendStackDecision", "capabilityInventory", "selection"],
  "properties": {
    "schema": {"const": "design-pipeline.design-system-decision.v1"},
    "status": {"enum": ["ready", "review", "blocked"]},
    "mode": {"enum": ["reference", "adopt", "substitute", "custom"]},
    "projectAuthority": {"type": ["object", "null"]},
    "selected": {"type": ["object", "null"]},
    "rejected": {"type": "array", "items": {"type": "object"}},
    "rationale": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "frontendStackDecision": {"type": ["object", "null"]},
    "capabilityInventory": {"type": ["object", "null"]},
    "selection": {"oneOf": [{"$ref": "#/$defs/selection"}, {"type": "null"}]},
    "request": {"type": "object", "description": "Resolved inputs for deterministic decision replay; publication does not itself authenticate owner authority."},
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestPath", "inputHashes"],
      "properties": {
        "requestPath": {"$ref": "#/$defs/relativePath"},
        "inputHashes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/relativePath"},
          "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "bundledCatalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "sha256"],
          "properties": {
            "source": {"const": "references/astryx-design-system-snapshot.json"},
            "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          },
          "description": "Identifies the implicit catalog in the consumer's current installed skill, not a project-relative file."
        }
      },
      "description": "Workflow consumers reread and hash project-bound sources, including requestPath; shared validation also rereads the current installed bundledCatalog and checks its hash and resolved catalog before replay."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"selected": {"type": "object"}, "frontendStackDecision": {"type": "object"}, "selection": {"$ref": "#/$defs/selection"}}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}, "mode": {"enum": ["reference", "adopt", "substitute"]}}},
      "then": {"properties": {"capabilityInventory": {"type": "object"}, "selection": {"properties": {"basis": {"const": "capability-search"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}, "mode": {"const": "adopt"}}},
      "then": {"properties": {"selection": {"properties": {"authority": {"properties": {"actor": {"const": "owner"}, "source": {"enum": ["request", "reply"]}}}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}, "mode": {"const": "custom"}, "selection": {"type": "object", "properties": {"basis": {"const": "capability-search"}}}}},
      "then": {"properties": {"capabilityInventory": {"type": "object"}, "selection": {"$ref": "#/$defs/ownerFallback"}}}
    },
    {
      "if": {"properties": {"status": {"const": "ready"}, "mode": {"const": "substitute"}}},
      "then": {"properties": {"selection": {"$ref": "#/$defs/ownerFallback"}}}
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "authority", "rationale", "compared"],
      "properties": {
        "basis": {"enum": ["owner-scratch", "preserve-existing", "capability-search"]},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor", "source", "text", "choice"],
          "properties": {
            "actor": {"enum": ["owner", "agent"]},
            "source": {"enum": ["request", "reply", "project"]},
            "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "choice": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "compatibility": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "compared": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"basis": {"const": "owner-scratch"}}},
          "then": {"properties": {"authority": {"properties": {"actor": {"const": "owner"}, "source": {"enum": ["request", "reply"]}, "choice": {"const": "custom"}}}}}
        },
        {
          "if": {"properties": {"basis": {"const": "preserve-existing"}}},
          "then": {"properties": {"authority": {"properties": {"source": {"const": "project"}}}}}
        }
      ]
    },
    "ownerFallback": {
      "allOf": [
        {"$ref": "#/$defs/selection"},
        {
          "required": ["compatibility"],
          "properties": {
            "basis": {"const": "capability-search"},
            "authority": {"properties": {"actor": {"const": "owner"}, "source": {"enum": ["request", "reply"]}}},
            "compared": {"minItems": 1}
          }
        }
      ]
    }
  }
}