      "lifecycle": {
        "probe": {
          "kind": "command",
          "command": ["node", "-e", "const fs=require('node:fs'),p=require('node:path');const read=n=>{const f=p.join(process.cwd(),'node_modules',...n.split('/'),'package.json');return fs.existsSync(f)?JSON.parse(fs.readFileSync(f,'utf8')).version:null};const d=read('@vitejs/devtools'),v=read('vite'),vp=read('vite-plus');if(!d)process.exit(2);process.stdout.write(`devtools=${d};vite=${v||'unknown'};vite-plus=${vp||'absent'}`)"],
          "timeoutMs": 5000
        },
        "invoke": {"kind": "managed-cli", "owner": "agent", "target": "project-local vite-devtools binary", "command": ["vite-devtools", "--root", ".", "--no-open"]},
        "verify": {"receiptSchema": "design-pipeline.toolchain-receipt.v1", "evidenceTypes": ["devtools-availability", "mounted-integrations", "browser-console", "playwright-trace"]}
