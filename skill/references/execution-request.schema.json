{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/design-pipeline/schema/execution-request.v1.json",
  "title": "Execution Target Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "toolchainPlanSha256", "preferredMode", "isolation", "slices"],
  "properties": {
    "schema": { "const": "design-pipeline.execution-request.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "toolchainPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preferredMode": { "enum": ["auto", "in-place", "worktree", "sequential"] },
    "isolation": { "enum": ["optional", "required"] },
    "routeId": { "type": "string", "minLength": 1 },
    "jobPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "branch": { "type": "string", "pattern": "^codex/[a-z0-9][a-z0-9._/-]{0,100}$" },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "owner": { "type": "string", "minLength": 1 },
          "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
