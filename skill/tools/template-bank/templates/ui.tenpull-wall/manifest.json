{
  "schema": "design-pipeline.template-bank-template.v1",
  "id": "ui.tenpull-wall",
  "family": "ui",
  "style": "citypop-sleeve",
  "title": "Ten-pull results as a wall of postcards: nine cards pinned at ±5 degrees, the top pull twice their size in the middle",
  "use": "The result screen of a ten-pull: ten results of mixed rarity, a summary card and confirm / pull-again buttons.",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "sizes": [
    "1920x1080",
    "2560x1440",
    "3840x2160"
  ],
  "aspect": "16:9",
  "accent": {
    "roles": [
      "lemon"
    ],
    "maxShare": 0.2
  },
  "params": {
    "guides": {
      "type": "boolean",
      "default": false,
      "class": "decoration",
      "note": "draw layout guides"
    },
    "wobble": {
      "default": 1,
      "min": 0.6,
      "max": 1.2,
      "class": "rhythm",
      "note": "scale of every card's tilt (1 = the case's -5 to +5 degrees)"
    },
    "icon_0": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "lifebuoy",
      "class": "decoration",
      "note": "icon of the top pull (card 0)"
    },
    "icon_1": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "palm",
      "class": "decoration",
      "note": "icon of card 1"
    },
    "icon_2": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "record",
      "class": "decoration",
      "note": "icon of card 2"
    },
    "icon_3": {
      "type": "enum",
