        "record",
        "tray",
        "camera"
      ],
      "default": "tray",
      "class": "decoration",
      "note": "icon of card 3"
    },
    "icon_4": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "cocktail",
      "class": "decoration",
      "note": "icon of card 4"
    },
    "icon_5": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "board",
      "class": "decoration",
      "note": "icon of card 5"
    },
    "icon_6": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
