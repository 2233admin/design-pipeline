    "icon_7": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "record",
      "class": "decoration",
      "note": "icon of card 7"
    },
    "icon_8": {
      "type": "enum",
      "values": [
        "lifebuoy",
