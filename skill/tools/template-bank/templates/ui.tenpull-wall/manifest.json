        "蓝晶",
        "汽水瓶盖"
      ],
      "maxChars": 4,
      "font": "label"
    },
    "cur_{i}_value": {
      "kind": "text",
      "default": [
        "2",
        "3,580",
        "60"
      ],
      "maxChars": 6,
      "font": "num"
    },
