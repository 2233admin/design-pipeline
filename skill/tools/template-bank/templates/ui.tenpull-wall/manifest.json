        "跳水员 · NEW",
        "园丁",
        "重复 · 汽水瓶盖 +10",
        "侍应",
        "摄影师 · NEW"
      ],
      "maxChars": 14,
      "font": "label"
    },
    "top_stamp": {
      "kind": "text",
      "default": "NEW",
      "maxChars": 3,
      "font": "num"
    },
    "summary_title": {
      "kind": "text",
      "default": "十连结果",
      "maxChars": 5,
      "font": "head"
    },
    "summary_range": {
      "kind": "text",
      "default": "第 38–47 次",
      "maxChars": 10,
      "font": "label"
    },
    "summary_row_{i}": {
      "kind": "text",
      "default": [
        "6★ ×1",
        "5★ ×1",
        "4★ ×4",
        "3★ ×4"
      ],
      "maxChars": 8,
      "font": "label"
    },
