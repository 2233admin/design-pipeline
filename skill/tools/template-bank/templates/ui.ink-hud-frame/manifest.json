{
  "schema": "design-pipeline.template-bank-template.v1",
  "id": "ui.ink-hud-frame",
  "family": "ui",
  "style": "megastructure-ink",
  "title": "In-game descent HUD: a heading ruler, a depth ladder and readout, a viewport (abstract plate or image slot) in hairline corners with a reticle and the scale marker, three segmented gauges, a monitor comms panel and an alarm banner",
  "use": "An in-game cockpit or terminal screen. view=drawn|slot; alert shows the banner; gauge_1-3 set the gauges (0-1).",
