      "type": "boolean",
      "default": false,
      "class": "decoration",
      "note": "draw layout guides"
    },
    "view": {
      "type": "enum",
      "values": [
        "drawn",
        "slot"
      ],
      "default": "drawn",
      "class": "decoration",
      "note": "draw the abstract viewport plate or leave the image slot"
    },
    "seed_plate": {
      "default": 47,
      "min": 1,
      "max": 999,
      "class": "rhythm",
      "note": "seed of the viewport plate"
    },
    "alert": {
      "type": "boolean",
