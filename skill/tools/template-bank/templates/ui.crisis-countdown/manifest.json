{
  "schema": "design-pipeline.template-bank-template.v1",
  "id": "ui.crisis-countdown",
  "family": "ui",
  "style": "crisis-command",
  "title": "Countdown bezel: a chamfered amber bezel with a bracketed Mincho label, a capsule-digit clock with Mincho units, a slanted LCD elapsed clock, a row of four mode cells and a danger cell, two supply plates (one lit)",
  "use": "Countdowns, launch and deadline screens, live timers on a status page.",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "sizes": [
    "1920x1080",
    "2560x1440"
  ],
  "aspect": "16:9",
  "accent": {
    "roles": [
      "alert"
    ],
    "maxShare": 0.18
  },
  "params": {
    "guides": {
      "type": "boolean",
      "default": false,
      "class": "decoration",
      "note": "draw layout guides"
    },
    "state": {
      "type": "enum",
      "values": [
        "normal",
        "danger"
      ],
      "default": "normal",
      "class": "decoration",
      "note": "danger turns the ink red-orange and fills the danger cell (a hard cut)"
    },
    "mode": {
      "default": 3,
      "min": 1,
      "max": 4,
      "class": "decoration",
      "note": "the lit mode cell"
    },
    "supply": {
      "default": 1,
      "min": 1,
      "max": 2,
      "class": "decoration",
      "note": "the lit supply plate"
    },
    "scanlines": {
      "type": "boolean",
      "default": true,
      "class": "decoration",
      "note": "scanlines inside the bezel"
    }
  },
  "slots": {
    "label": {
      "kind": "text",
      "default": "蓄压剩余",
      "maxChars": 6,
      "font": "head",
      "title": true
    },
    "label_latin": {
      "kind": "text",
      "default": "RESERVE PRESSURE REMAINING",
      "maxChars": 30,
      "font": "grot",
      "note": "Latin only"
    },
    "clock": {
      "kind": "lettering",
      "default": "04:59:58",
      "maxChars": 8,
      "note": "hh:mm:ss, drawn capsule digits"
    },
    "unit_h": {
      "kind": "text",
      "default": "时",
      "maxChars": 1,
      "font": "head"
    },
    "unit_m": {
      "kind": "text",
      "default": "分",
      "maxChars": 1,
      "font": "head"
    },
    "unit_s": {
      "kind": "text",
      "default": "秒",
      "maxChars": 1,
      "font": "head"
    },
    "t_label": {
      "kind": "text",
      "default": "T+ ELAPSED",
      "maxChars": 12,
      "font": "grot"
    },
    "elapsed": {
      "kind": "lettering",
      "default": "00:12:07.53",
      "maxChars": 11,
      "note": "hh:mm:ss.cc, slanted LCD digits"
    },
    "mode_1": {
      "kind": "text",
      "default": "HOLD",
      "maxChars": 8,
      "font": "grot"
