  "relations": [
    "Units at 0.21 of the digit height, the label at 0.27 between vertical bracket bars.",
    "The elapsed clock at 0.32 of the main clock, slanted 6 degrees.",
    "Bezel corners cut at 45 degrees; one mode cell lit."
  ],
  "decoration": [
    "Hazard stripes on the lit plate, the bezel's inner rule, scanlines and the mark are drawn and exempt."
  ],
  "provenance": {
    "corpus": "tidemark case (潮位警报 TIDEMARK): our own original organisation terminal site, two app screens and UI kit in the crisis-command grammar",
    "experiment": "styles/crisis-command/style.json provenance (reference frames measured privately; never shipped)",
    "accessed": "2026-11-06",
    "method": "a reference film's clock (strip, middle third): digits 0.36 wide per digit with gap, units 0.21, label 0.27 in bracket bars; a reference countdown's mode row and danger cell; frame-by-frame red share of the danger cut",
    "sampleIds": [
      "tidemark/crisis-countdown"
    ],
    "measured": [
