      "maxChars": 8,
      "font": "grot"
    },
    "mode_3": {
      "kind": "text",
      "default": "NORMAL",
      "maxChars": 8,
      "font": "grot"
    },
    "mode_4": {
      "kind": "text",
      "default": "SURGE",
      "maxChars": 8,
      "font": "grot"
    },
    "danger_1": {
      "kind": "text",
      "default": "DANGER",
      "maxChars": 10,
      "font": "grot"
    },
    "danger_2": {
      "kind": "text",
      "default": "EMERGENCY",
      "maxChars": 10,
      "font": "grot"
    },
    "plate_cjk_1": {
      "kind": "text",
      "default": "内蓄",
      "maxChars": 2,
      "font": "head"
    },
    "plate_latin_1": {
      "kind": "text",
      "default": "RESERVE",
      "maxChars": 9,
