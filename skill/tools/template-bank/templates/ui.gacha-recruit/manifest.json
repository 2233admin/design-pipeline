{
  "schema": "design-pipeline.template-bank-template.v1",
  "id": "ui.gacha-recruit",
  "family": "ui",
  "style": "citypop-sleeve",
  "title": "Recruit screen: the limited banner as a record sleeve with the record sliding out, tabs as pinned cards, a lemon ten-pull button",
  "use": "A gacha recruit (summon) screen with one featured limited banner, its rates, pity progress and single / ten pulls.",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "sizes": [
    "1920x1080",
    "2560x1440",
    "3840x2160"
  ],
  "aspect": "16:9",
  "accent": {
    "roles": [
      "lemon"
    ],
    "maxShare": 0.16
  },
  "params": {
    "guides": {
      "type": "boolean",
      "default": false,
      "class": "decoration",
      "note": "draw layout guides"
    },
    "tabs": {
      "type": "integer",
      "default": 4,
      "min": 2,
      "max": 4,
      "class": "decoration",
      "note": "banner tabs on the left (the first is active; from the third on they are dashed: finished or locked)"
    },
    "sleeve_tilt": {
      "default": -4,
      "min": -5,
      "max": -2,
      "class": "rhythm",
      "note": "sleeve tilt, degrees"
    },
    "pity": {
      "default": 0.4625,
      "min": 0,
      "max": 1,
      "class": "decoration",
      "note": "pity progress bar fill (data)"
    },
    "up_icon_0": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "cocktail",
      "class": "decoration",
      "note": "icon of the first rate-up card"
    },
    "up_icon_1": {
      "type": "enum",
      "values": [
        "lifebuoy",
        "cocktail",
        "board",
        "palm",
        "record",
        "tray",
        "camera"
      ],
      "default": "board",
      "class": "decoration",
      "note": "icon of the second rate-up card"
    }
  },
