{
  "note": "Canonical recording shape for the interaction probe. `document` is a fully specified probe document (no field left to a default) and `capture` is one clean recording of a card that follows the pointer with a spring-like settle: the card leaves rest at frame 48 ms, overshoots its final x by 4.9 px and is quiet from 240 ms onward. interaction-core's evaluator consumes exactly this shape; interaction-capture-core produces exactly this shape. Both test files assert against this file so the two layers cannot drift apart.",
  "document": {
    "schema": "design-pipeline.interaction-probe.v1",
    "id": "sample-card",
    "url": "index.html",
    "viewport": { "width": 1280, "height": 800 },
    "probes": [
      {
        "id": "card-follows-pointer",
        "target": "#card",
        "input": { "kind": "pointer-sweep", "from": [200, 400], "to": [1080, 400], "durationMs": 96 },
        "expect": { "responds": true, "settleWithinMs": 160, "returnsToRest": false, "response": "spring" }
      }
    ]
  },
  "capture": {
