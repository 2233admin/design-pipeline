{
  "name": "design-pipeline-maintenance",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "evals/cases",
    "tools/browser-automation"
  ],
  "scripts": {
    "test": "node scripts/qa.cjs && npm run test:browser",
    "test:browser": "npm test --workspace tools/browser-automation",
    "deps:check": "npm outdated --workspaces --include-workspace-root",
    "specs:check": "openspec validate --all --strict",
    "capabilities:check": "node skill/scripts/audit-capabilities.cjs --json",
    "sources:check": "node scripts/sources-check.cjs",
    "sources:update": "node scripts/sources-update.cjs",
    "sources:import:mengto": "node scripts/import-mengto-skills.cjs",
    "sources:import:iart": "node scripts/import-iart-motion-skills.cjs",
    "sources:import:designmd": "node scripts/import-design-md.cjs",
    "sources:import:goodcss": "node scripts/import-good-css.cjs",
    "art-motion:build": "node scripts/build-art-motion-runtime.cjs",
    "test:art-motion": "uv run --with fonttools==4.66.1 node --test tests/art-motion-runtime.test.cjs tests/art-motion-scroll.test.cjs tests/art-motion-assets-audio.test.cjs tests/art-motion-tools.test.cjs tests/art-motion-voice.test.cjs",
    "browser:install": "npm run install-browser --workspace tools/browser-automation && hyperframes browser ensure",
    "package:skill": "node scripts/package.cjs",
    "install:skill": "node scripts/install-local.cjs",
    "sources:import:taste": "node scripts/import-taste-skill.cjs",
    "sources:import:film": "node scripts/import-film-sources.cjs",
    "templates:discover": "node scripts/refresh-prompt-motion-index.cjs",
    "sources:import:gepa": "node scripts/import-gepa.cjs",
    "sources:import:ui-craft": "node scripts/import-ui-craft-sources.cjs",
    "sources:import:direction-library": "node scripts/import-design-direction-library.cjs",
    "sources:import:answer-html": "node scripts/import-answer-me-with-html.cjs",
    "answer-html:build": "node scripts/build-answer-me-with-html-runtime.cjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0"
  }
}
