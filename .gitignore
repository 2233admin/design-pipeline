# Root dotpaths belong to local tools unless explicitly shared below.
/.*
!/.gitattributes
!/.gitignore
!/.github/
!/.claude-plugin/

# Local agent installations and generated planning output are not product source.
# Keep the reviewed official GEPA skill's inert original paths in its source bundle.
!skill/vendor/gepa/upstream/.claude/
!skill/vendor/gepa/upstream/.claude/**
/_bmad/
/_bmad-output/
/skills-lock.json

# This tracked upstream source must survive personal *.bin ignore rules.
!/skill/vendor/mengto-skills/upstream/agent-skills/game-combat/water-crystal-skill-vfx/demo/layout/layout.bin

# Local tool state, not product source.
/orca/
/osprey/

# Pinned npm package outputs the answer-me-with-html manifest lists; the global dist/ rule must not drop them.
!/skill/vendor/answer-me-with-html/dependencies/**/dist/
